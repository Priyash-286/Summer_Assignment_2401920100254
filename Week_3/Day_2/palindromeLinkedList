class Solution {
    public boolean isPalindrome(ListNode head) {
        ListNode dummy = new ListNode(0);
        ListNode copy = dummy;
        ListNode temp = head;
        while (temp != null) {
            copy.next = new ListNode(temp.val);
            copy = copy.next;
            temp = temp.next;
        }
        ListNode prev = null;
        ListNode curr = dummy.next;
        while (curr != null) {
            ListNode next = curr.next;
            curr.next = prev;
            prev = curr;
            curr = next;
        }
        ListNode a = head;
        ListNode b = prev;
        while (a != null && b != null) {
            if (a.val != b.val) return false;
            a = a.next;
            b = b.next;
        }
        return true;
    }
}
