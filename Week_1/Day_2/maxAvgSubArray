class Solution {
    public double findMaxAverage(int[] nums, int k) {
        long sum = 0 ;
        long max = Long.MIN_VALUE;
        int n = nums.length;
        for(int i = 0 ; i < n ; i++){
            sum += nums[i];

            if(i >= k){
                sum -= nums[i-k];
            }
            if( i >= k-1){
                max = Math.max(max,sum);
            }
        }
        return (double)max/k;
        
    }
}