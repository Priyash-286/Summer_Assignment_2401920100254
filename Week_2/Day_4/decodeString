class Solution {

    int i = 0;

    public String decodeString(String s) {
        String result = "";

        while (i < s.length() && s.charAt(i) != ']') {

            char ch = s.charAt(i);

            if (Character.isLetter(ch)) {
                result += ch;
                i++;
            } else {
                int num = 0;

                while (Character.isDigit(s.charAt(i))) {
                    num = num * 10 + (s.charAt(i) - '0');
                    i++;
                }

                i++; 

                String decoded = decodeString(s);

                i++; 

                for (int j = 0; j < num; j++) {
                    result += decoded;
                }
            }
        }

        return result;
    }
}